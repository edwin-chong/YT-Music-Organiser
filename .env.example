# LLM provider used for song classification -- pick ONE:
#
# Option A: Anthropic directly
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed if your API key is an org-level key not scoped to a workspace
# (you'll see a 400 "not scoped to a workspace" error otherwise) -- get this
# id from console.anthropic.com -> Settings -> Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Option B: OpenRouter (routes to Anthropic, OpenAI, and many other models)
OPENROUTER_API_KEY=
# Optional override -- any model slug from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Optional: force a specific provider instead of auto-detecting from
# whichever API key above is set ("anthropic" or "openrouter"). Only needed
# if you've filled in both keys and want to pick one explicitly.
LLM_PROVIDER=

YOUTUBE_CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
DAILY_QUOTA_BUDGET=9500
